{
  "id": "CustomerOnboarding",
  "title": "Customer Onboarding Workflow",
  "steps": [
    {
      "id": "Location",
      "title": "Location",
      "fields": [
        {
          "key": "CountryId",
          "label": "Country",
          "type": "Select",
          "required": true,
          "placeholder": "Select a country",
          "dataSource": "Countries"
        },
        {
          "key": "CityId",
          "label": "City",
          "type": "Select",
          "required": true,
          "placeholder": "Select a city",
          "dataSource": "Cities",
          "dependsOn": ["CountryId"]
        },
        {
          "key": "DistrictId",
          "label": "District",
          "type": "Select",
          "placeholder": "Select a district",
          "dataSource": "Districts",
          "dependsOn": ["CityId"]
        }
      ]
    },
    {
      "id": "Address",
      "title": "Address",
      "fields": [
        {
          "key": "Street",
          "label": "Street",
          "type": "Text",
          "required": true,
          "placeholder": "221B Baker Street"
        },
        {
          "key": "BuildingNo",
          "label": "Building Number",
          "type": "Number",
          "required": true,
          "placeholder": "12"
        },
        {
          "key": "PostalCode",
          "label": "Postal Code",
          "type": "Text",
          "required": true,
          "placeholder": "12345"
        }
      ]
    },
    {
      "id": "Preferences",
      "title": "Preferences",
      "fields": [
        {
          "key": "IsBusiness",
          "label": "Business customer",
          "type": "Checkbox"
        },
        {
          "key": "CompanyName",
          "label": "Company Name",
          "type": "Text",
          "placeholder": "Contoso Ltd.",
          "visibleWhen": {
            "field": "IsBusiness",
            "equals": "true"
          }
        },
        {
          "key": "InterestedServices",
          "label": "Interested Services",
          "type": "CheckboxList",
          "dataSource": "Services",
          "visibleWhen": {
            "field": "IsBusiness",
            "equals": "true"
          }
        },
        {
          "key": "SupportNotes",
          "label": "Support Notes",
          "type": "Text",
          "placeholder": "Any special support request",
          "visibleWhen": {
            "field": "InterestedServices",
            "contains": "Consulting"
          }
        },
        {
          "key": "Newsletter",
          "label": "Subscribe to newsletter",
          "type": "Checkbox",
          "visibleWhen": {
            "field": "IsBusiness",
            "notEquals": "true"
          }
        }
      ]
    }
  ]
}
