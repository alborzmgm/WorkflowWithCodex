@using WorkflowWithCodex.WorkflowEngine.WorkflowEngine

<div class="col-12">
    <label class="form-label mb-2">@Field.Label @RequiredMarker</label>
    <div class="checkboxlist-panel p-2 p-md-3 @(HasError ? "is-invalid" : string.Empty)">
        <div class="row g-2 g-md-3">
            @foreach (var option in Options)
            {
                <div class="col-12 col-sm-6 col-lg-4">
                    <div class="form-check p-0 m-0">
                        <input id="@GetId(option.Value)" class="form-check-input visually-hidden" type="checkbox" disabled="@IsDisabled" checked="@IsSelected(option.Value)" @onchange="args => OnChanged(option.Value, args)" />
                        <label class="form-check-label checkboxlist-option w-100 @(IsSelected(option.Value) ? "checkboxlist-option-selected" : string.Empty)" for="@GetId(option.Value)">
                            <span class="checkboxlist-indicator" aria-hidden="true"></span>
                            <span class="fw-medium">@option.Label</span>
                        </label>
                    </div>
                </div>
            }
            @if (Options.Count == 0)
            {
                <div class="col-12 text-secondary small">No items available.</div>
            }
        </div>
    </div>
    @if (HasError)
    {
        <div class="text-danger small mt-1">@ValidationMessage</div>
    }
</div>

@code {
    [Parameter] public required FieldDefinition Field { get; set; }
    [Parameter] public object? Value { get; set; }
    [Parameter] public IReadOnlyList<SelectOption> Options { get; set; } = [];
    [Parameter] public bool IsDisabled { get; set; }
    [Parameter] public bool ShowValidation { get; set; }
    [Parameter] public string? ValidationMessage { get; set; }
    [Parameter] public EventCallback<object?> ValueChanged { get; set; }

    private HashSet<string> SelectedValues => Value switch
    {
        IEnumerable<string> values => values.ToHashSet(StringComparer.OrdinalIgnoreCase),
        _ => []
    };

    private string RequiredMarker => Field.Required ? "*" : string.Empty;
    private bool HasError => ShowValidation && !string.IsNullOrWhiteSpace(ValidationMessage);

    private bool IsSelected(string value) => SelectedValues.Contains(value);

    private string GetId(string value) => $"{Field.Key}_{value}";

    private Task OnChanged(string value, ChangeEventArgs args)
    {
        var selectedValues = SelectedValues;
        var shouldSelect = args.Value is bool boolValue && boolValue;

        if (shouldSelect)
        {
            selectedValues.Add(value);
        }
        else
        {
            selectedValues.Remove(value);
        }

        return ValueChanged.InvokeAsync(selectedValues.ToList());
    }
}
